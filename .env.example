# Copy this file to .env and adjust as needed.
# Every variable has a sensible default, so the app also runs with no .env at all.

# --- HTTP server ---
PORT=4000
NODE_ENV=development

# Origin allowed by CORS during development (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# --- Email service ---
# "console" logs the message to stdout (default, no credentials required).
# "resend" delivers for real through the Resend API — use this in production.
EMAIL_TRANSPORT=resend

# Inbox that receives the contact notifications. Any address works here.
CONTACT_TO=ferezsoluciones@gmail.com

# Sender address. IMPORTANT: Resend only accepts a domain verified in your
# account, so a Gmail address will be REJECTED here (you do not own gmail.com).
# Use onboarding@resend.dev until you verify a domain of your own.
# The visitor's address always goes in Reply-To, so replying to the notification
# reaches the right person regardless of what this is set to.
CONTACT_FROM=onboarding@resend.dev

# Required only when EMAIL_TRANSPORT=resend. Get it at https://resend.com/api-keys
RESEND_API_KEY=

# --- Contact rate limiting ---
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# --- Runtime detection (normally not set by hand) ---
# Vercel sets VERCEL=1 automatically. Set SERVERLESS=1 locally to reproduce the
# serverless code path: leads stop being written to disk and a failed
# notification email makes the request fail instead of being swallowed.
# SERVERLESS=1
