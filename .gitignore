# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local

# Runtime data. Kept out of server/src/data/ — which holds committed content —
# and out of dist/, which the build deletes.
server/data/

# Incremental build caches. Committing these lets a fresh CI checkout decide the
# project is already up to date and skip type-checking entirely.
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
